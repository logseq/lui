(rule
 (target lui_runtime_native.ml)
 (deps
  ../lg/lui/lui_native.state
  (source_tree ../lg/lui/backend)
  %{lib:lg-test.sources:test.cljc}
  %{lib:lg-test.sources:test_native.cljc}
  (source_tree ../examples/todos/lg/todos)
  (source_tree ../examples/components/lg/components)
  ../examples/components/test/components/app_test.cljc
  ../examples/todos/test/todos/app_test.cljc
  lui/runtime_test.cljc
  lui/hot_reload_test.cljc
  lui/hot_reload_view_test.cljc
  lui/phase2_hot_reload_test.cljc
  lui/authoring_test.cljc
  lui/dynamic_test.cljc
  lui/extension_test.cljc
  lui/benchmark_test.cljc
  %{lib:lg-test.sources:run.cljc}
  %{lib:lg-test.runtime:lg_test_runtime.cmi}
  %{lib:lg-test.alcotest:lg_test_alcotest.cmi}
  %{bin:lg})
 (action
  (run
   %{bin:lg}
   --target native
   --compile-files-from ../lg/lui/lui_native.state
   ../lg/lui/backend/retained
   ../lg/lui/backend/apple
   ../lg/lui/backend/flutter
   %{lib:lg-test.sources:test.cljc}
   %{lib:lg-test.sources:test_native.cljc}
   ../examples/todos/lg/todos
   ../examples/components/lg/components
   %{dep:../examples/components/test/components/app_test.cljc}
   %{dep:../examples/todos/test/todos/app_test.cljc}
   %{dep:lui/runtime_test.cljc}
   %{dep:lui/hot_reload_test.cljc}
   %{dep:lui/hot_reload_view_test.cljc}
   %{dep:lui/phase2_hot_reload_test.cljc}
   %{dep:lui/authoring_test.cljc}
   %{dep:lui/dynamic_test.cljc}
   %{dep:lui/extension_test.cljc}
   %{dep:lui/benchmark_test.cljc}
   %{lib:lg-test.sources:run.cljc}
   -o %{target})))

