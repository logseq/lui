  lg.runtime
  lg.rrbvec
  lg-test.runtime
  lg-test.melange
  melange-webapi))

(rule
 (alias runtest)
 (deps
  lui_runtime_native.exe
  (alias lui-runtime-melange)
  lui-runtime-melange/test/lui_runtime_melange.js)
 (action
  (progn
   (run %{exe:lui_runtime_native.exe})
   (run node %{dep:lui-runtime-melange/test/lui_runtime_melange.js}))))

