(rule
 (targets
  hot_reload_repl_base.ml
  hot_reload_repl_increment.ml
  hot_reload_repl_base.state)
 (deps
  ../lg/lui/lui_native.state
  (source_tree ../lg/lui/backend/retained)
  (source_tree ../lg/lui/backend/apple)
  %{bin:lg})
 (action
  (progn
   (run
    %{bin:lg}
    --target native
    --compile-files-from
    ../lg/lui/lui_native.state
    ../lg/lui/backend/retained
    ../lg/lui/backend/apple
    -o hot_reload_repl_base.ml)
   (run
    %{bin:lg}
    --target native
    --compile-files-from-state
    ../lg/lui/lui_native.state
    hot_reload_repl_base.state
    ../lg/lui/backend/retained
    ../lg/lui/backend/apple
    -o hot_reload_repl_increment.ml))))

