# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0"
synopsis: "A reactive retained cross-platform UI runtime written in LG"
description:
  "Declarative UI, incremental patch batching, and Apple, Flutter, and Web backends powered by signal-lg."
maintainer: ["Tienson Qin <tiensonqin@gmail.com>"]
authors: ["Tienson Qin"]
license: "MIT"
depends: [
  "ocaml" {>= "5.4"}
  "dune" {>= "3.17" & >= "3.17"}
  "melange" {>= "6.0"}
  "melange-webapi"
  "lg"
  "lg-test"
  "ctypes"
  "ctypes-foreign"
  "signal-lg"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
