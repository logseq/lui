(ns components.model)

(type-record gallery-model
  (gallery-disabled :bool)
  (gallery-field-value :string)
  (gallery-checked :bool)
  (gallery-progress :float)
  (gallery-active-step :int)
  (gallery-density :string)
  (gallery-volume :float)
  (gallery-environment :string)
  (gallery-picker-query :string)
  (gallery-open-picker :string)
  (gallery-document :string)
  (gallery-document-action :string)
  (gallery-avatar-image :int)
  (gallery-media-surface :int)
  (gallery-tab :string)
  (gallery-dialog-open :bool)
  (gallery-drawer-open :bool)
  (gallery-sheet-open :bool)
  (gallery-accordion-open :bool)
  (gallery-split-fraction :float))

(type-variant gallery-action
  (ToggleDisabled)
  (SetFieldValue :string)
  (SetChecked :bool)
  (SetDensity :string)
  (SetVolume :float)
  (OpenPicker :string)
  (SetPickerQuery :string)
  (SelectEnvironment :string)
  (ClosePicker)
  (CommitPickerQuery)
  (SelectDocument :string)
  (OpenDocument :string)
  (PerformContextAction :string)
  (ToggleAvatarImage)
  (SelectTab :string)
  (OpenDialog)
  (CloseDialog)
  (OpenDrawer)
  (CloseDrawer)
  (OpenSheet)
  (CloseSheet)
  (SetAccordionOpen :bool)
  (SetSplitFraction :float)
  (AdvanceProgress)
  (AdvanceStep))

(signature components.model/initial :fn<gallery-model>)
(signature components.model/update
  :fn<gallery-model;gallery-action;gallery-model>)
(signature components.model/progress-label :fn<gallery-model;string>)
(signature components.model/density-comfortable? :fn<gallery-model;bool>)
(signature components.model/density-compact? :fn<gallery-model;bool>)
(signature components.model/volume-label :fn<gallery-model;string>)
(signature components.model/select-open? :fn<gallery-model;bool>)
(signature components.model/combobox-open? :fn<gallery-model;bool>)
(signature components.model/production-selected? :fn<gallery-model;bool>)
(signature components.model/staging-selected? :fn<gallery-model;bool>)
(signature components.model/report-selected? :fn<gallery-model;bool>)
(signature components.model/checklist-selected? :fn<gallery-model;bool>)
(signature components.model/overview-tab-selected? :fn<gallery-model;bool>)
(signature components.model/activity-tab-selected? :fn<gallery-model;bool>)
(signature components.model/tab-content :fn<gallery-model;string>)
