(ns components.app)

(signature components.app/create
  :fn<backend;reducer-app<gallery-model;gallery-action>>)
(signature components.app/create-with-extensions
  :fn<backend;extension-registry;reducer-app<gallery-model;gallery-action>>)
(signature components.app/model
  :fn<reducer-app<gallery-model;gallery-action>;gallery-model>)
