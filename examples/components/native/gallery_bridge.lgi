(signature components.flutter-bridge/press :fn<int;string>)
(signature components.flutter-bridge/hold :fn<int;string>)
(signature components.flutter-bridge/text-changed :fn<int;string;string>)
(signature components.flutter-bridge/toggle-changed :fn<int;bool;string>)
