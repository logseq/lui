  :fn<reducer-app<todo-model;todo-action>>)
(signature todos.flutter-bridge/initialize :fn<int;int;string>)
(signature todos.flutter-bridge/appear :fn<int;string>)
(signature todos.flutter-bridge/press :fn<int;string>)
(signature todos.flutter-bridge/text-changed :fn<int;string;string>)
(signature todos.flutter-bridge/toggle-changed :fn<int;bool;string>)
(signature todos.flutter-bridge/radio-changed :fn<int;string>)
(signature todos.flutter-bridge/slider-changed :fn<int;float;string>)
