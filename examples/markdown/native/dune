(library
 (name markdown_bridge)
 (modules markdown_bridge)
 (libraries lui ocaml-signal markdown_app)
 (wrapped false))

(rule
 (enabled_if
  (= %{os_type} "Darwin"))
 (target liblui_markdown.dylib)
 (deps
  ../../../platform/native/lui_ocaml_bridge.c
  markdown_bridge.cmxa
  ../markdown_app.cmxa
  ../../../src/lui.cmxa)
 (action
  (run
   sh
   -c
   "ocamlfind ocamlopt -linkpkg -package ocaml-signal \
      %{dep:../../../src/lui.cmxa} %{dep:../markdown_app.cmxa} \
      %{dep:markdown_bridge.cmxa} \
      -output-complete-obj -o markdown_bridge_complete.o && \
    cc -shared -o %{target} \
      %{dep:../../../platform/native/lui_ocaml_bridge.c} \
      markdown_bridge_complete.o \
      -I\"$(ocamlfind ocamlc -where)\" -lpthread")))
