(ns lui.dynamic)

(type-record ui-switch
  (dispose-dynamic-switch :fn<bool>)
  (switch-node-ref :ref<option<int>>))

(type-record ui-conditional
  (dispose-dynamic-conditional :fn<bool>)
  (conditional-node-ref :ref<option<int>>))

(type-record ui-key-node [key]
  (ui-key :key)
  (ui-node :int))

(type-record ui-keyed [key]
  (dispose-dynamic-keyed :fn<bool>)
  (key-nodes :ref<vector<ui-key-node<key>>>)
  (key-compare :fn<key;key;int>))

(signature lui.dynamic/switch! [key]
  :fn<ui-context;int;signal<key>;fn<key;key;bool>;fn<ui-context;key;int>;ui-switch>)
(signature lui.dynamic/make-switch
  :fn<fn<bool>;ref<option<int>>;ui-switch>)
(signature lui.dynamic/segment-disposer
  :fn<application;dynamic-segment;fn<bool>;fn<bool>>)
(signature lui.dynamic/switch-node :fn<ui-switch;int>)
(signature lui.dynamic/dispose-switch! :fn<ui-switch;bool>)
(signature lui.dynamic/make-conditional
  :fn<fn<bool>;ref<option<int>>;ui-conditional>)
(signature lui.dynamic/conditional!
  :fn<ui-context;int;signal<bool>;fn<ui-context;int>;ui-conditional>)
(signature lui.dynamic/conditional-node :fn<ui-conditional;int>)
(signature lui.dynamic/dispose-conditional! :fn<ui-conditional;bool>)
(signature lui.dynamic/find-key-node [key]
  :fn<vector<ui-key-node<key>>;key;fn<key;key;int>;option<int>>)
(signature lui.dynamic/remove-key-node! [key]
  :fn<ref<vector<ui-key-node<key>>>;key;fn<key;key;int>;bool>)
(signature lui.dynamic/mount-keyed-item! [key item]
  :fn<ui-context;int;dynamic-segment;fn<item;key>;fn<key;key;int>;fn<ui-context;signal<item>;int>;ref<vector<ui-key-node<key>>>;signal<item>;scope>)
(signature lui.dynamic/keyed! [key item]
  :fn<ui-context;int;signal<vector<item>>;fn<item;key>;fn<key;key;int>;fn<ui-context;signal<item>;int>;ui-keyed<key>>)
(signature lui.dynamic/make-keyed [key]
  :fn<fn<bool>;ref<vector<ui-key-node<key>>>;fn<key;key;int>;ui-keyed<key>>)
(signature lui.dynamic/keyed-node [key]
  :fn<ui-keyed<key>;key;int>)
(signature lui.dynamic/dispose-keyed! [key]
  :fn<ui-keyed<key>;bool>)
