(ns lui.hot-reload)

(type-variant reload-status
  (ReloadApplied :int)
  (ReloadUnchanged :int)
  (ReloadRejected :int :string)
  (ReloadStale :int)
  (ReloadRestartRequired :int :string))

(type-record reload-event
  (reload-event-generation :int)
  (reload-event-source-hash :string)
  (reload-event-status :reload-status)
  (reload-event-elapsed-ms :int))

(type-record committed-root [root]
  (committed-root-value :root)
  (committed-root-source-hash :string)
  (committed-root-generation :int))

(type-record hot-reload-session [root]
  (hot-reload-committed-root :ref<committed-root<root>>)
  (hot-reload-contract-hash :string)
  (hot-reload-requested-generation :ref<int>)
  (hot-reload-completed-generation :ref<int>)
  (hot-reload-events :ref<vector<reload-event>>))

(signature lui.hot-reload/create [root]
  :fn<string;string;root;hot-reload-session<root>>)
(signature lui.hot-reload/request! [root]
  :fn<hot-reload-session<root>;int>)
(signature lui.hot-reload/preflight [root]
  :fn<hot-reload-session<root>;int;string;string;option<reload-status>>)
(signature lui.hot-reload/publish! [root]
  :fn<hot-reload-session<root>;int;string;string;root;fn<root;option<string>>;int;reload-status>)
(signature lui.hot-reload/current-root [root]
  :fn<hot-reload-session<root>;root>)
(signature lui.hot-reload/generation [root]
  :fn<hot-reload-session<root>;int>)
(signature lui.hot-reload/source-hash [root]
  :fn<hot-reload-session<root>;string>)
(signature lui.hot-reload/events [root]
  :fn<hot-reload-session<root>;vector<reload-event>>)
(signature lui.hot-reload/latest-event [root]
  :fn<hot-reload-session<root>;option<reload-event>>)
