(ns lui.migration)

(type-record model-snapshot [payload]
  (snapshot-version :int)
  (snapshot-fingerprint :string)
  (snapshot-payload :payload))

(type-variant snapshot-capture-result [payload]
  (SnapshotCaptured :model-snapshot<payload>)
  (SnapshotCaptureRejected :string))

(type-record migration-plan [payload model]
  (migration-source-version :int)
  (migration-source-fingerprint :string)
  (migration-target-fingerprint :string)
  (migrate-snapshot :fn<payload;model>)
  (validate-model :fn<model;option<string>>))

(type-variant migration-result [model]
  (MigrationApplied :model)
  (MigrationRejected :string)
  (MigrationRestartRequired :string))

(type-variant soft-restart-status [target]
  (SoftRestartApplied :target)
  (SoftRestartRejected :string)
  (SoftRestartRequired :string))

(type-record generation-message [message]
  (message-generation :int)
  (message-fingerprint :string)
  (message-value :message))

(type-record message-drain [message]
  (compatible-messages :vector<message>)
  (discarded-message-count :int))

(signature lui.migration/capture [model payload]
  :fn<int;string;model;fn<model;payload>;snapshot-capture-result<payload>>)
(signature lui.migration/apply [payload model]
  :fn<migration-plan<payload;model>;model-snapshot<payload>;migration-result<model>>)
(signature lui.migration/soft-restart! [model target]
  :fn<migration-result<model>;fn<model;target>;fn<target;bool>;fn<target;bool>;fn<bool>;soft-restart-status<target>>)
(signature lui.migration/drain-compatible [message]
  :fn<vector<generation-message<message>>;int;string;message-drain<message>>)
