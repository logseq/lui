(ns lui.ui)

(type-record ui-context
  (ui-application :application)
  (ui-scheduler :scheduler)
  (ui-scope :scope)
  (ui-profile :platform-profile))

(signature lui.ui/context :fn<application;scope;ui-context>)
(signature lui.ui/child-context :fn<ui-context;string;ui-context>)
(signature lui.ui/profile :fn<ui-context;platform-profile>)
(signature lui.ui/platform :fn<ui-context;operating-system>)
(signature lui.ui/host :fn<ui-context;host-kind>)
(signature lui.ui/row! :fn<ui-context;int>)
(signature lui.ui/column! :fn<ui-context;int>)
(signature lui.ui/box! :fn<ui-context;int>)
(signature lui.ui/scroll! :fn<ui-context;int>)
(signature lui.ui/spacer! :fn<ui-context;int>)
(signature lui.ui/text! :fn<ui-context;string;int>)
(signature lui.ui/heading! :fn<ui-context;int;string;int>)
(signature lui.ui/heading-value!
  :fn<ui-context;int;signal<wire-value>;int>)
(signature lui.ui/heading-signal!
  :fn<ui-context;int;signal<string>;int>)
(signature lui.ui/paragraph! :fn<ui-context;string;int>)
(signature lui.ui/paragraph-value!
  :fn<ui-context;signal<wire-value>;int>)
(signature lui.ui/paragraph-signal!
  :fn<ui-context;signal<string>;int>)
(signature lui.ui/label! :fn<ui-context;string;int>)
(signature lui.ui/label-value! :fn<ui-context;signal<wire-value>;int>)
(signature lui.ui/label-signal! :fn<ui-context;signal<string>;int>)
(signature lui.ui/text-signal! :fn<ui-context;signal<string>;int>)
(signature lui.ui/text-value! :fn<ui-context;signal<wire-value>;int>)
(signature lui.ui/text-input!
  :fn<ui-context;signal<string>;fn<event;bool>;int>)
(signature lui.ui/text-input-value!
  :fn<ui-context;signal<wire-value>;fn<event;bool>;int>)
(signature lui.ui/text-area!
  :fn<ui-context;signal<string>;fn<event;bool>;int>)
(signature lui.ui/text-area-value!
  :fn<ui-context;signal<wire-value>;fn<event;bool>;int>)
(signature lui.ui/button! :fn<ui-context;string;fn<event;bool>;int>)
(signature lui.ui/disabled-signal!
  :fn<ui-context;int;signal.core/signal<bool>;bool>)
(signature lui.ui/invalid-signal!
  :fn<ui-context;int;signal.core/signal<bool>;bool>)
(signature lui.ui/labelled-by! :fn<ui-context;int;int;bool>)
(signature lui.ui/described-by! :fn<ui-context;int;int;bool>)
(signature lui.ui/error-message-by! :fn<ui-context;int;int;bool>)
(signature lui.ui/input-type! :fn<ui-context;int;string;bool>)
(signature lui.ui/style-class! :fn<ui-context;int;string;bool>)
(signature lui.ui/append! :fn<ui-context;int;int;bool>)
(signature lui.ui/gap! :fn<ui-context;int;int;bool>)
(signature lui.ui/padding! :fn<ui-context;int;int;bool>)
(signature lui.ui/background! :fn<ui-context;int;string;bool>)
(signature lui.ui/placeholder! :fn<ui-context;int;string;bool>)
(signature lui.ui/read-only! :fn<ui-context;int;bool;bool>)
(signature lui.ui/accessibility-label! :fn<ui-context;int;string;bool>)
(signature lui.ui/min-lines! :fn<ui-context;int;int;bool>)
(signature lui.ui/max-lines! :fn<ui-context;int;int;bool>)
