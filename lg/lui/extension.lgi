(ns lui.extension)

(type-variant scalar-kind
  (StringScalar)
  (BoolScalar)
  (IntScalar)
  (FloatScalar))

(type-record extension-property-schema
  (extension-property-name :string)
  (extension-property-kind :scalar-kind)
  (extension-property-required :bool)
  (extension-property-default :option<wire-value>))

(type-record extension-event-field-schema
  (extension-event-field-name :string)
  (extension-event-field-kind :scalar-kind)
  (extension-event-field-required :bool))

(type-record extension-event-schema
  (extension-event-name :string)
  (extension-event-fields :vector<extension-event-field-schema>))

(type-record extension-component-schema
  (extension-identifier :string)
  (extension-profiles :vector<platform-profile>)
  (extension-standard-children :bool)
  (extension-child-identifiers :vector<string>)
  (extension-properties :vector<extension-property-schema>)
  (extension-events :vector<extension-event-schema>))

(type-record extension-registry
  (extension-schemas :ref<map<string;extension-component-schema>>)
  (extension-registry-frozen :ref<bool>))

(signature lui.extension/property
  :fn<string;scalar-kind;bool;option<wire-value>;extension-property-schema>)
(signature lui.extension/event-field
  :fn<string;scalar-kind;bool;extension-event-field-schema>)
(signature lui.extension/event
  :fn<string;vector<extension-event-field-schema>;extension-event-schema>)
(signature lui.extension/component
  :fn<string;vector<platform-profile>;bool;vector<string>;vector<extension-property-schema>;vector<extension-event-schema>;extension-component-schema>)
(signature lui.extension/scalar-value-supported?
  :fn<scalar-kind;wire-value;bool>)
(signature lui.extension/scalar-kind-name :fn<scalar-kind;string>)
(signature lui.extension/operating-system-name :fn<operating-system;string>)
(signature lui.extension/host-name :fn<host-kind;string>)
(signature lui.extension/token :fn<string;string>)
(signature lui.extension/wire-value-token :fn<wire-value;string>)
(signature lui.extension/option-value-token :fn<option<wire-value>;string>)
(signature lui.extension/insert-sorted
  :fn<vector<string>;string;vector<string>>)
(signature lui.extension/sorted-strings
  :fn<vector<string>;vector<string>>)
(signature lui.extension/profile-token :fn<platform-profile;string>)
(signature lui.extension/property-token
  :fn<extension-property-schema;string>)
(signature lui.extension/event-field-token
  :fn<extension-event-field-schema;string>)
(signature lui.extension/event-token :fn<extension-event-schema;string>)
(signature lui.extension/fingerprint :fn<extension-component-schema;string>)
(signature lui.extension/registry :fn<extension-registry>)
(signature lui.extension/register-component!
  :fn<extension-registry;extension-component-schema;bool>)
(signature lui.extension/freeze! :fn<extension-registry;bool>)
(signature lui.extension/frozen? :fn<extension-registry;bool>)
(signature lui.extension/schema
  :fn<extension-registry;string;option<extension-component-schema>>)
(signature lui.extension/profile-supported?
  :fn<extension-component-schema;platform-profile;bool>)
(signature lui.extension/standard-container-supported? :fn<node-kind;bool>)
(signature lui.extension/identifier-allowed?
  :fn<vector<string>;string;bool>)
(signature lui.extension/property-value-supported?
  :fn<extension-component-schema;string;wire-value;bool>)
(signature lui.extension/property-supported?
  :fn<extension-component-schema;string;bool>)
(signature lui.extension/properties-supported?
  :fn<extension-component-schema;map<string;wire-value>;bool>)
(signature lui.extension/event-payload-supported?
  :fn<extension-component-schema;string;map<string;wire-value>;bool>)
