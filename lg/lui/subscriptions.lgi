(ns lui.subscriptions)

(type-variant subscription-reload-status
  (SubscriptionsApplied :int)
  (SubscriptionsUnchanged :int)
  (SubscriptionsRejected :int :string)
  (SubscriptionsStale :int))

(type-record subscription-spec [message]
  (subscription-key :string)
  (subscription-fingerprint :string)
  (start-subscription :fn<fn<message;bool>;subscription>))

(type-record active-subscription
  (active-subscription-fingerprint :string)
  (active-subscription-value :subscription))

(type-variant subscription-build-result
  (SubscriptionsPrepared :map<string;active-subscription>)
  (SubscriptionsPrepareRejected :string))

(type-record subscription-coordinator [message]
  (subscription-dispatch :fn<message;bool>)
  (active-subscriptions :ref<map<string;active-subscription>>)
  (subscription-completed-generation :ref<int>))

(signature lui.subscriptions/create [message]
  :fn<fn<message;bool>;subscription-coordinator<message>>)
(signature lui.subscriptions/reject! [message]
  :fn<subscription-coordinator<message>;int;string;subscription-reload-status>)
(signature lui.subscriptions/validate-unique-keys! [message]
  :fn<vector<subscription-spec<message>>;option<string>>)
(signature lui.subscriptions/same-active? [message]
  :fn<active-subscription;subscription-spec<message>;bool>)
(signature lui.subscriptions/unchanged? [message]
  :fn<map<string;active-subscription>;vector<subscription-spec<message>>;bool>)
(signature lui.subscriptions/dispose-started!
  :fn<ref<vector<subscription>>;bool>)
(signature lui.subscriptions/build-desired [message]
  :fn<map<string;active-subscription>;vector<subscription-spec<message>>;fn<message;bool>;subscription-build-result>)
(signature lui.subscriptions/reconcile! [message]
  :fn<subscription-coordinator<message>;int;vector<subscription-spec<message>>;subscription-reload-status>)
(signature lui.subscriptions/dispose! [message]
  :fn<subscription-coordinator<message>;bool>)
(signature lui.subscriptions/count [message]
  :fn<subscription-coordinator<message>;int>)
