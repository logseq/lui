(ns lui.runtime)

(type-record event-handler
  (handler-id :int)
  (handler-callback :fn<event;bool>))

(type-record dynamic-segment
  (dynamic-segment-id :int)
  (dynamic-segment-parent :int)
  (dynamic-segment-base :ref<int>)
  (dynamic-segment-size :ref<int>)
  (dynamic-segment-active :ref<bool>))

(type-variant flush-status
  (NotFlushed)
  (NoBatch)
  (Applied)
  (Rejected))

(type-record flush-diagnostics
  (flush-status :flush-status)
  (flush-generation :int)
  (flush-operation-count :int)
  (flush-pending-operation-count :int)
  (flush-mounted-node-count :int)
  (flush-handler-count :int)
  (flush-dynamic-segment-count :int)
  (flush-signal-generation :int)
  (flush-signal-round-count :int)
  (flush-signal-effect-count :int)
  (flush-signal-dirty-task-count :int))

(type-record application
  (runtime-scheduler :scheduler)
  (runtime-backend :backend)
  (runtime-extension-registry :extension-registry)
  (next-node-id :ref<int>)
  (mounted-nodes :ref<map<int;node-kind>>)
  (runtime-extension-nodes :ref<map<int;string>>)
  (runtime-properties :ref<map<int;map<property;wire-value>>>)
  (runtime-extension-properties :ref<map<int;map<string;wire-value>>>)
  (runtime-children :ref<map<int;vector<int>>>)
  (runtime-parents :ref<map<int;int>>)
  (pending-ops :ref<vector<patch-op>>)
  (runtime-generation :ref<int>)
  (runtime-diagnostics :ref<flush-diagnostics>)
  (next-handler-id :ref<int>)
  (event-handlers :ref<map<int;vector<event-handler>>>)
  (next-dynamic-segment-id :ref<int>)
  (dynamic-segments :ref<map<int;vector<dynamic-segment>>>))

(signature lui.runtime/create :fn<scheduler;backend;application>)
(signature lui.runtime/create-with-extensions
  :fn<scheduler;backend;extension-registry;application>)
(signature lui.runtime/empty-ops :fn<vector<patch-op>>)
(signature lui.runtime/empty-handlers :fn<vector<event-handler>>)
(signature lui.runtime/empty-dynamic-segments
  :fn<map<int;vector<dynamic-segment>>>)
(signature lui.runtime/empty-extension-nodes :fn<map<int;string>>)
(signature lui.runtime/empty-extension-properties
  :fn<map<int;map<string;wire-value>>>)
(signature lui.runtime/enqueue! :fn<application;patch-op;bool>)
(signature lui.runtime/find-child-index
  :fn<vector<int>;int;option<int>>)
(signature lui.runtime/remove-at :fn<vector<int>;int;vector<int>>)
(signature lui.runtime/insert-at :fn<vector<int>;int;int;vector<int>>)
(signature lui.runtime/move-at :fn<vector<int>;int;int;vector<int>>)
(signature lui.runtime/descendant? :fn<application;int;int;bool>)
(signature lui.runtime/extension-identifier
  :fn<application;int;option<string>>)
(signature lui.runtime/require-extension-schema
  :fn<application;int;extension-component-schema>)
(signature lui.runtime/require-node! :fn<application;int;bool>)
(signature lui.runtime/create-node! :fn<application;node-kind;int>)
(signature lui.runtime/create-extension-node!
  :fn<application;string;int>)
(signature lui.runtime/create-tweak-node! :fn<application;string;int>)
(signature lui.runtime/drop-node! :fn<application;int;bool>)
(signature lui.runtime/drop-subtree! :fn<application;int;bool>)
(signature lui.runtime/set-prop! :fn<application;int;property;wire-value;bool>)
(signature lui.runtime/set-extension-prop!
  :fn<application;int;string;wire-value;bool>)
(signature lui.runtime/remove-extension-prop!
  :fn<application;int;string;bool>)
(signature lui.runtime/standard-extension-container? :fn<node-kind;bool>)
(signature lui.runtime/identifier-allowed?
  :fn<vector<string>;string;bool>)
(signature lui.runtime/child-supported? :fn<application;int;int;bool>)
(signature lui.runtime/insert-child! :fn<application;int;int;int;bool>)
(signature lui.runtime/remove-child! :fn<application;int;int;bool>)
(signature lui.runtime/move-child! :fn<application;int;int;int;bool>)
(signature lui.runtime/bind-prop! [value]
  :fn<scope;application;int;property;signal<wire-value>;subscription>)
(signature lui.runtime/bind-extension-prop!
  :fn<scope;application;int;string;signal<wire-value>;subscription>)
(signature lui.runtime/on-event!
  :fn<scope;application;int;fn<event;bool>;bool>)
(signature lui.runtime/remove-handler!
  :fn<application;int;int;bool>)
(signature lui.runtime/dispatch! :fn<application;event;bool>)
(signature lui.runtime/validate-extension-nodes! :fn<application;bool>)
(signature lui.runtime/handler-count :fn<application;int>)
(signature lui.runtime/dynamic-segment-count :fn<application;int>)
(signature lui.runtime/record-diagnostics!
  :fn<application;flush-status;int;int;bool>)
(signature lui.runtime/apply-pending-batch!
  :fn<application;patch-batch;int;int;bool>)
(signature lui.runtime/flush! :fn<application;bool>)
(signature lui.runtime/diagnostics :fn<application;flush-diagnostics>)
(signature lui.runtime/generation :fn<application;int>)
(signature lui.runtime/mounted-count :fn<application;int>)
(signature lui.runtime/child-count :fn<application;int;int>)
(signature lui.runtime/children :fn<application;int;vector<int>>)
(signature lui.runtime/find-dynamic-segment-index
  :fn<vector<dynamic-segment>;int;option<int>>)
(signature lui.runtime/register-dynamic-segment!
  :fn<application;int;dynamic-segment>)
(signature lui.runtime/dynamic-segment-index
  :fn<dynamic-segment;int;int>)
(signature lui.runtime/dynamic-segment-insert-index
  :fn<dynamic-segment;int;int>)
(signature lui.runtime/resize-dynamic-segment!
  :fn<application;dynamic-segment;int;bool>)
(signature lui.runtime/unregister-dynamic-segment!
  :fn<application;dynamic-segment;bool>)
