(ns lui.backend.retained)

(type-record retained-node [platform]
  (platform-node :platform)
  (semantic-kind :node-kind)
  (retained-parent :option<int>)
  (retained-properties :map<property;wire-value>)
  (retained-children :vector<int>))

(type-record retained-store [platform]
  (retained-nodes :ref<map<int;retained-node<platform>>>)
  (retained-batches :ref<vector<patch-batch>>)
  (retained-generation :ref<int>))

(signature lui.backend.retained/create-store [platform]
  :fn<retained-store<platform>>)
(signature lui.backend.retained/empty-batches
  :fn<vector<patch-batch>>)
(signature lui.backend.retained/find-child-index
  :fn<vector<int>;int;option<int>>)
(signature lui.backend.retained/remove-at [value]
  :fn<vector<value>;int;vector<value>>)
(signature lui.backend.retained/insert-at [value]
  :fn<vector<value>;int;value;vector<value>>)
(signature lui.backend.retained/move-at [value]
  :fn<vector<value>;int;int;vector<value>>)
(signature lui.backend.retained/update-node [platform]
  :fn<map<int;retained-node<platform>>;int;retained-node<platform>;map<property;wire-value>;vector<int>;map<int;retained-node<platform>>>)
(signature lui.backend.retained/update-parent [platform]
  :fn<map<int;retained-node<platform>>;int;retained-node<platform>;option<int>;map<int;retained-node<platform>>>)
(signature lui.backend.retained/remove-reference
  :fn<map<property;wire-value>;property;int;map<property;wire-value>>)
(signature lui.backend.retained/remove-relationships-to [platform]
  :fn<map<int;retained-node<platform>>;int;map<int;retained-node<platform>>>)
(signature lui.backend.retained/descendant? [platform]
  :fn<map<int;retained-node<platform>>;int;int;bool>)
(signature lui.backend.retained/apply-op [platform]
  :fn<map<int;retained-node<platform>>;fn<node-kind;platform>;patch-op;map<int;retained-node<platform>>>)
(signature lui.backend.retained/apply-operations [platform]
  :fn<map<int;retained-node<platform>>;fn<node-kind;platform>;patch-batch;map<int;retained-node<platform>>>)
(signature lui.backend.retained/apply-batch-with! [platform]
  :fn<retained-store<platform>;fn<node-kind;platform>;fn<patch-batch;bool>;patch-batch;bool>)
(signature lui.backend.retained/apply-batch! [platform]
  :fn<retained-store<platform>;fn<node-kind;platform>;patch-batch;bool>)
(signature lui.backend.retained/node [platform]
  :fn<retained-store<platform>;int;option<retained-node<platform>>>)
(signature lui.backend.retained/nodes [platform]
  :fn<retained-store<platform>;map<int;retained-node<platform>>>)
(signature lui.backend.retained/property [platform]
  :fn<retained-store<platform>;int;property;option<wire-value>>)
(signature lui.backend.retained/children [platform]
  :fn<retained-store<platform>;int;vector<int>>)
(signature lui.backend.retained/node-count [platform]
  :fn<retained-store<platform>;int>)
(signature lui.backend.retained/batches [platform]
  :fn<retained-store<platform>;vector<patch-batch>>)
(signature lui.backend.retained/generation [platform]
  :fn<retained-store<platform>;int>)
