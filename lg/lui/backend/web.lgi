(ns lui.backend.web
  (:require [ocaml.package/melange-webapi]))

(type-alias web-node :Dom.element)

(type-record web-renderer
  (web-store :retained-store<web-node>)
  (web-document :Dom.document)
  (web-event-handler :ref<fn<event;bool>>)
  (web-app-icons :map<string;string>))

(signature lui.backend.web/create
  :overload<fn<Dom.element;web-renderer>;fn<Dom.element;map<string;string>;web-renderer>>)
(signature lui.backend.web/set-event-handler!
  :fn<web-renderer;fn<event;bool>;bool>)
(signature lui.backend.web/platform-node :fn<web-renderer;node-kind;web-node>)
(signature lui.backend.web/dom-node :fn<web-renderer;int;web-node>)
(signature lui.backend.web/relationship-dom-node
  :fn<web-renderer;int;web-node>)
(signature lui.backend.web/attribute-target?
  :fn<web-node;string;int;bool>)
(signature lui.backend.web/clear-dom-relationships!
  :fn<map<int;retained-node<web-node>>;int;bool>)
(signature lui.backend.web/dom-node-before
  :fn<web-renderer;map<int;retained-node<web-node>>;int;web-node>)
(signature lui.backend.web/attach-events!
  :fn<web-renderer;int;node-kind;web-node;unit>)
(signature lui.backend.web/attach-toggle-event!
  :fn<web-renderer;int;node-kind;web-node;unit>)
(signature lui.backend.web/attach-radio-event!
  :fn<web-renderer;int;web-node;unit>)
(signature lui.backend.web/attach-slider-event!
  :fn<web-renderer;int;web-node;unit>)
(signature lui.backend.web/set-state-attribute!
  :fn<web-node;string;bool;unit>)
(signature lui.backend.web/web-color-value :fn<string;string>)
(signature lui.backend.web/update-icon-name!
  :fn<web-renderer;web-node;string;unit>)
(signature lui.backend.web/apply-property!
  :fn<web-renderer;int;node-kind;web-node;property;wire-value;unit>)
(signature lui.backend.web/progress-float
  :fn<web-renderer;int;float>)
(signature lui.backend.web/update-progress!
  :fn<web-renderer;int;web-node;unit>)
(signature lui.backend.web/insert-dom-child!
  :fn<web-node;web-node;int;unit>)
(signature lui.backend.web/radio-group-ancestor
  :fn<web-renderer;int;option<int>>)
(signature lui.backend.web/update-radio-group!
  :fn<web-renderer;int;unit>)
(signature lui.backend.web/apply-dom-op!
  :fn<web-renderer;map<int;retained-node<web-node>>;patch-op;unit>)
(signature lui.backend.web/apply-dom-batch!
  :fn<web-renderer;map<int;retained-node<web-node>>;patch-batch;unit>)
(signature lui.backend.web/backend :fn<web-renderer;backend>)
(signature lui.backend.web/mount!
  :fn<web-renderer;int;Dom.element;unit>)
(signature lui.backend.web/some-node
  :fn<web-node;option<web-node>>)
(signature lui.backend.web/node :fn<web-renderer;int;option<web-node>>)
(signature lui.backend.web/property
  :fn<web-renderer;int;property;option<wire-value>>)
(signature lui.backend.web/children :fn<web-renderer;int;vector<int>>)
(signature lui.backend.web/node-count :fn<web-renderer;int>)
(signature lui.backend.web/batches :fn<web-renderer;vector<patch-batch>>)
