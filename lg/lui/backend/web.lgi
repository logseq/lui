(ns lui.backend.web
  (:require [ocaml.package/melange-webapi]))

(type-alias web-node :Dom.element)

(type-record web-image-resource
  (web-image-url :string)
  (web-image-width :float)
  (web-image-height :float))

(type-record web-renderer
  (web-store :retained-store<web-node>)
  (web-document :Dom.document)
  (web-event-handler :ref<fn<event;bool>>)
  (web-app-icons :map<string;string>)
  (web-images :ref<map<int;web-image-resource>>)
  (web-cleanups :ref<map<int;fn<unit>>>)
  (web-modal-stack :ref<vector<int>>))

(signature lui.backend.web/create
  :overload<fn<Dom.element;web-renderer>;fn<Dom.element;map<string;string>;web-renderer>>)
(signature lui.backend.web/set-event-handler!
  :fn<web-renderer;fn<event;bool>;bool>)
(signature lui.backend.web/register-image!
  :fn<web-renderer;int;string;float;float;bool>)
(signature lui.backend.web/unregister-image!
  :fn<web-renderer;int;bool>)
(signature lui.backend.web/avatar-float
  :fn<web-renderer;int;property;float;float>)
(signature lui.backend.web/registered-avatar-image
  :fn<web-renderer;int;option<web-image-resource>>)
(signature lui.backend.web/update-avatar!
  :fn<web-renderer;int;web-node;unit>)
(signature lui.backend.web/refresh-avatar-image-id!
  :fn<web-renderer;int;bool>)
(signature lui.backend.web/platform-node :fn<web-renderer;node-kind;web-node>)
(signature lui.backend.web/dom-node :fn<web-renderer;int;web-node>)
(signature lui.backend.web/dom-node-before
  :fn<web-renderer;map<int;retained-node<web-node>>;int;web-node>)
(signature lui.backend.web/attach-events!
  :fn<web-renderer;int;node-kind;web-node;unit>)
(signature lui.backend.web/attach-text-events!
  :fn<web-renderer;int;node-kind;web-node;unit>)
(signature lui.backend.web/attach-toggle-event!
  :fn<web-renderer;int;node-kind;web-node;unit>)
(signature lui.backend.web/attach-radio-event!
  :fn<web-renderer;int;web-node;unit>)
(signature lui.backend.web/attach-slider-event!
  :fn<web-renderer;int;web-node;unit>)
(signature lui.backend.web/attach-picker-press-event!
  :fn<web-renderer;int;web-node;unit>)
(signature lui.backend.web/attach-accordion-event!
  :fn<web-renderer;int;web-node;unit>)
(signature lui.backend.web/attach-pressable-text-events!
  :fn<web-renderer;int;web-node;unit>)
(signature lui.backend.web/event-capability?
  :fn<web-renderer;int;property;bool>)
(signature lui.backend.web/treeitem? :fn<web-renderer;int;bool>)
(signature lui.backend.web/tree-ancestor
  :fn<web-renderer;int;option<int>>)
(signature lui.backend.web/tree-items-under
  :fn<web-renderer;int;vector<int>>)
(signature lui.backend.web/tree-focus-items-under
  :fn<web-renderer;int;vector<int>>)
(signature lui.backend.web/derived-tree-item-level
  :fn<web-renderer;int;int;int;int>)
(signature lui.backend.web/tree-item-level
  :fn<web-renderer;int;int;int>)
(signature lui.backend.web/update-tree-roving!
  :fn<web-renderer;int;unit>)
(signature lui.backend.web/refresh-tree-item-accessibility!
  :fn<web-renderer;int;int;unit>)
(signature lui.backend.web/update-all-tree-roving!
  :fn<web-renderer;bool>)
(signature lui.backend.web/dispatch-tree-selection!
  :fn<web-renderer;int;unit>)
(signature lui.backend.web/attach-tree-item-events!
  :fn<web-renderer;int;node-kind;web-node;unit>)
(signature lui.backend.web/attach-list-item-events!
  :fn<web-renderer;int;web-node;unit>)
(signature lui.backend.web/horizontal-group-child?
  :fn<node-kind;node-kind;bool>)
(signature lui.backend.web/enabled-node? :fn<web-renderer;int;bool>)
(signature lui.backend.web/horizontal-focus-children
  :fn<web-renderer;int;node-kind;vector<int>>)
(signature lui.backend.web/focused-child-index
  :fn<web-renderer;vector<int>;Dom.element;int;option<int>>)
(signature lui.backend.web/horizontal-focus-index
  :fn<string;option<int>;int;option<int>>)
(signature lui.backend.web/attach-horizontal-focus!
  :fn<web-renderer;int;node-kind;web-node;unit>)
(signature lui.backend.web/attach-dropdown-events!
  :fn<web-renderer;int;web-node;unit>)
(signature lui.backend.web/cleanup-node!
  :fn<web-renderer;int;unit>)
(signature lui.backend.web/set-state-attribute!
  :fn<web-node;string;bool;unit>)
(signature lui.backend.web/web-color-value :fn<string;string>)
(signature lui.backend.web/update-icon-name!
  :fn<web-renderer;web-node;string;unit>)
(signature lui.backend.web/refresh-node-class!
  :fn<web-renderer;int;node-kind;web-node;unit>)
(signature lui.backend.web/apply-property!
  :fn<web-renderer;int;node-kind;web-node;property;wire-value;unit>)
(signature lui.backend.web/progress-float
  :fn<web-renderer;int;float>)
(signature lui.backend.web/update-progress!
  :fn<web-renderer;int;web-node;unit>)
(signature lui.backend.web/insert-dom-child!
  :fn<web-node;web-node;int;unit>)
(signature lui.backend.web/content-container
  :fn<node-kind;web-node;web-node>)
(signature lui.backend.web/radio-group-ancestor
  :fn<web-renderer;int;option<int>>)
(signature lui.backend.web/update-radio-group!
  :fn<web-renderer;int;unit>)
(signature lui.backend.web/apply-dom-op!
  :fn<web-renderer;map<int;retained-node<web-node>>;patch-op;unit>)
(signature lui.backend.web/apply-dom-batch!
  :fn<web-renderer;map<int;retained-node<web-node>>;patch-batch;unit>)
(signature lui.backend.web/backend :fn<web-renderer;backend>)
(signature lui.backend.web/mount!
  :fn<web-renderer;int;Dom.element;unit>)
(signature lui.backend.web/some-node
  :fn<web-node;option<web-node>>)
(signature lui.backend.web/node :fn<web-renderer;int;option<web-node>>)
(signature lui.backend.web/property
  :fn<web-renderer;int;property;option<wire-value>>)
(signature lui.backend.web/children :fn<web-renderer;int;vector<int>>)
(signature lui.backend.web/node-count :fn<web-renderer;int>)
(signature lui.backend.web/batches :fn<web-renderer;vector<patch-batch>>)
