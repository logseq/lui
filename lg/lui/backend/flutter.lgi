(ns lui.backend.flutter)

(type-variant flutter-node
  (FlutterFlexRow)
  (FlutterFlexColumn)
  (FlutterGrid)
  (FlutterStack)
  (FlutterPanel)
  (FlutterCard)
  (FlutterBox)
  (FlutterParagraph)
  (FlutterHeading)
  (FlutterFormLabel)
  (FlutterButton)
  (FlutterToggleButton)
  (FlutterWidgetIsland)
  (FlutterCheckbox)
  (FlutterSwitch)
  (FlutterProgress)
  (FlutterToggle)
  (FlutterRadioGroup)
  (FlutterRadio)
  (FlutterSlider)
  (FlutterDivider)
  (FlutterViewport)
  (FlutterList)
  (FlutterTabs)
  (FlutterSpacer)
  (FlutterSpinner)
  (FlutterIcon)
  (FlutterSelect)
  (FlutterCombobox)
  (FlutterDropdownMenu)
  (FlutterMenuItem)
  (FlutterListItem)
  (FlutterAvatar))

(type-record flutter-renderer
  (flutter-store :retained-store<flutter-node>)
  (flutter-send-batch :fn<patch-batch;bool>))

(signature lui.backend.flutter/create
  :overload<fn<flutter-renderer>;fn<fn<patch-batch;bool>;flutter-renderer>>)
(signature lui.backend.flutter/create-wire
  :fn<fn<string;bool>;flutter-renderer>)
(signature lui.backend.flutter/platform-node :fn<node-kind;flutter-node>)
(signature lui.backend.flutter/backend-for
  :fn<flutter-renderer;operating-system;backend>)
(signature lui.backend.flutter/backend :fn<flutter-renderer;backend>)
(signature lui.backend.flutter/some-node
  :fn<flutter-node;option<flutter-node>>)
(signature lui.backend.flutter/node :fn<flutter-renderer;int;option<flutter-node>>)
(signature lui.backend.flutter/property
  :fn<flutter-renderer;int;property;option<wire-value>>)
(signature lui.backend.flutter/children :fn<flutter-renderer;int;vector<int>>)
(signature lui.backend.flutter/node-count :fn<flutter-renderer;int>)
(signature lui.backend.flutter/batches :fn<flutter-renderer;vector<patch-batch>>)
