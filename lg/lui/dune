(rule
 (targets lui_native.ml lui_native.state)
 (deps
  %{lib:signal-lg.states:signal_native.state}
  (source_tree .)
  %{bin:lg})
 (action
  (run
   %{bin:lg}
   --target native
   --compile-files-from-state
   %{lib:signal-lg.states:signal_native.state}
   lui_native.state
   -o lui_native.ml)))

(rule
 (targets lui_native_backends.ml lui_native_backends.state)
 (deps
  lui_native.state
  (source_tree backend)
  %{bin:lg})
 (action
  (run
   %{bin:lg}
   --target native
   --compile-files-from-state
   lui_native.state
   lui_native_backends.state
   backend/retained
   backend/apple
   backend/flutter
   -o lui_native_backends.ml)))

