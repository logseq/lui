(ns lui.backend.web
  (:require [ocaml.package/melange-webapi]))

(type-alias web-node :Dom.element)

(type-record web-extension-adapter
  (web-extension-create
   :fn<int;Dom.document;fn<string;map<string;wire-value>;unit>;web-node>)
  (web-extension-set-property
   :fn<web-node;string;wire-value;unit>)
  (web-extension-remove-property :fn<web-node;string;unit>)
  (web-extension-cleanup :fn<web-node;unit>))

(type-record web-image-resource
  (web-image-url :string)
  (web-image-width :float)
  (web-image-height :float))

(type-record web-split-state
  (web-split-source :float)
  (web-split-current :float))

(type-record root-section
  (root-section-node :int)
  (root-section-title :string))

(type-variant web-simulator-form-factor
  (SimulatorPhone)
  (SimulatorTablet))

(type-variant web-simulator-orientation
  (SimulatorPortrait)
  (SimulatorLandscape))

(type-variant web-simulator-pointer
  (SimulatorTouch)
  (SimulatorHybrid))

(type-record web-simulator-device
  (simulator-device-platform :operating-system)
  (simulator-device-form-factor :web-simulator-form-factor)
  (simulator-device-orientation :web-simulator-orientation)
  (simulator-device-pointer :web-simulator-pointer)
  (simulator-device-width :int)
  (simulator-device-height :int)
  (simulator-device-scale :float)
  (simulator-device-safe-top :int)
  (simulator-device-safe-right :int)
  (simulator-device-safe-bottom :int)
  (simulator-device-safe-left :int)
  (simulator-device-keyboard-height :int))

(type-record web-renderer
  (web-store :retained-store<web-node>)
  (web-document :Dom.document)
  (web-host :web-node)
  (web-portal-root :web-node)
  (web-simulator-platform :ref<option<operating-system>>)
  (web-simulator-device :ref<option<web-simulator-device>>)
  (web-simulator-keyboard-visible :ref<bool>)
  (web-toast-viewport :web-node)
  (web-event-handler :ref<fn<event;bool>>)
  (web-app-icons :map<string;string>)
  (web-images :ref<map<int;web-image-resource>>)
  (web-media-surfaces :ref<map<int;web-image-resource>>)
  (web-cleanups :ref<map<int;fn<unit>>>)
  (web-modal-stack :ref<vector<int>>)
  (web-modal-return-focus :ref<option<web-node>>)
  (web-open-tooltip :ref<option<int>>)
  (web-tooltip-warm :ref<bool>)
  (web-open-context-menu :ref<option<int>>)
  (web-splits :ref<map<int;web-split-state>>)
  (web-extension-registry :extension-registry)
  (web-extension-adapters :map<string;web-extension-adapter>))

(signature lui.backend.web/create
  :overload<fn<Dom.element;web-renderer>;fn<Dom.element;map<string;string>;web-renderer>>)
(signature lui.backend.web/create-with-extensions
  :fn<Dom.element;map<string;string>;extension-registry;map<string;web-extension-adapter>;web-renderer>)
(signature lui.backend.web/create-simulator
