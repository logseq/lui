{
  "version": 1,
  "engine": {
    "name": "chromium",
    "locale": "en-US",
    "timezoneId": "UTC",
    "colorScheme": "light",
    "reducedMotion": "reduce"
  },
  "scenarios": [
    {
      "id": "ios-controls-phone",
      "reference": {
        "id": "alexpaul-swiftui",
        "scenario": "control metrics and presentation"
      },
      "platform": "ios",
      "galleryPage": "Button",
      "state": "default",
      "device": {
        "formFactor": "phone",
        "orientation": "portrait",
        "viewport": {
          "width": 390,
          "height": 844
        },
        "scale": 3
      },
      "scope": "simulator",
      "baseline": "baselines/ios-controls-phone.png",
      "budget": {
        "pixelDifferenceRatio": 0.002,
        "maxDifferentPixels": 5000
      },
      "dom": {
        "requiredSelectors": [
          ".lui-button",
          ".lui-gallery-navigation-back"
        ],
        "canvasCount": 0
      },
      "assertions": [
        "Buttons preserve iOS typography, radius, and 44 point touch targets",
        "The phone page uses one retained push-navigation detail"
      ]
    },
