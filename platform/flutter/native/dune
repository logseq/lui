(rule
 (target todos_bridge_chunk.ml)
 (deps
  %{lib:lg:stdlib/lg_stdlib_native.state}
  %{lib:signal-lg.sources:lg/signal/core.lgi}
  %{lib:signal-lg.sources:lg/signal/core.cljc}
  ../../../lg/lui/protocol.lgi
  ../../../lg/lui/protocol.cljc
  ../../../lg/lui/wire.lgi
  ../../../lg/lui/wire.cljc
  ../../../lg/lui/runtime.lgi
  ../../../lg/lui/runtime.cljc
  ../../../lg/lui/ui.lgi
  ../../../lg/lui/ui.cljc
  ../../../lg/lui/app.lgi
  ../../../lg/lui/app.cljc
  ../../../lg/lui/elements.cljc
