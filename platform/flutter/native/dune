  ../../../lg/lui/backend/flutter.cljc
  ../../../examples/todos/lg/todos/model.lgi
  ../../../examples/todos/lg/todos/model.cljc
  ../../../examples/todos/lg/todos/view.lgi
  ../../../examples/todos/lg/todos/view.cljc
  ../../../examples/todos/lg/todos/app.lgi
  ../../../examples/todos/lg/todos/app.cljc
  todos_bridge.lgi
  todos_bridge.cljc
  %{bin:lg})
 (action
  (run
   %{bin:lg}
   --target native
   --compile-files-from %{lib:lg:stdlib/lg_stdlib_native.state}
   %{lib:signal-lg.sources:lg/signal/core.lgi}
   %{lib:signal-lg.sources:lg/signal/core.cljc}
   %{dep:../../../lg/lui/protocol.lgi}
   %{dep:../../../lg/lui/protocol.cljc}
   %{dep:../../../lg/lui/wire.lgi}
   %{dep:../../../lg/lui/wire.cljc}
   %{dep:../../../lg/lui/runtime.lgi}
   %{dep:../../../lg/lui/runtime.cljc}
   %{dep:../../../lg/lui/ui.lgi}
   %{dep:../../../lg/lui/ui.cljc}
   %{dep:../../../lg/lui/app.lgi}
   %{dep:../../../lg/lui/app.cljc}
   %{dep:../../../lg/lui/elements.cljc}
   %{dep:../../../lg/lui/macros.cljc}
   %{dep:../../../lg/lui/dynamic.lgi}
   %{dep:../../../lg/lui/dynamic.cljc}
   %{dep:../../../lg/lui/backend/retained.lgi}
   %{dep:../../../lg/lui/backend/retained.cljc}
   %{dep:../../../lg/lui/backend/flutter.lgi}
   %{dep:../../../lg/lui/backend/flutter.cljc}
   %{dep:../../../examples/todos/lg/todos/model.lgi}
   %{dep:../../../examples/todos/lg/todos/model.cljc}
   %{dep:../../../examples/todos/lg/todos/view.lgi}
   %{dep:../../../examples/todos/lg/todos/view.cljc}
   %{dep:../../../examples/todos/lg/todos/app.lgi}
   %{dep:../../../examples/todos/lg/todos/app.cljc}
   %{dep:todos_bridge.lgi}
   %{dep:todos_bridge.cljc}
   -o %{target})))

(rule
 (target todos_bridge.ml)
 (deps %{lib:lg:stdlib/lg_stdlib_native.ml} todos_bridge_chunk.ml)
 (action
  (with-stdout-to %{target}
   (progn
    (cat %{lib:lg:stdlib/lg_stdlib_native.ml})
    (cat %{dep:todos_bridge_chunk.ml})))))

(rule
 (target todos_bridge_complete.o)
 (deps todos_bridge.ml)
 (action
  (run
   ocamlfind ocamlopt
   -package lg.edn-backend.native,lg.runtime,lg.rrbvec
   -linkpkg
   -output-complete-obj
   -o %{target}
   %{dep:todos_bridge.ml})))

(rule
 (target liblui_todos.dylib)
 (deps todos_bridge_complete.o lui_ocaml_bridge.c)
 (action
  (run
   clang
   -dynamiclib
   -o %{target}
   %{dep:lui_ocaml_bridge.c}
   %{dep:todos_bridge_complete.o}
   -I %{ocaml_where}
   -lpthread)))
