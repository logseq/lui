(rule
 (deps lui_metal_stubs.m)
 (action (copy %{deps} lui_metal_stubs.c)))

(library
 (name lui_metal)
 (modules lui_metal metal_source)
 (libraries lui_scene lui_gpu)
 (foreign_stubs
  (language c)
  (names lui_metal_stubs)
  (flags (:standard -x objective-c -fobjc-arc (:include c_flags.sexp))))
 (c_library_flags
  (:standard -framework Metal -framework QuartzCore (:include c_libs.sexp))))

(executable
 (name embed)
 (modules embed))

(rule
 (target metal_source.ml)
 (deps shader.metal)
 (action
  (with-stdout-to %{target}
   (run %{exe:embed.exe} shader.metal))))

(rule
 (target c_flags.sexp)
 (action
  (with-stdout-to %{target}
   (bash
    "printf '(%s)' \"$(pkg-config --cflags sdl2 2>/dev/null)\""))))

(rule
 (target c_libs.sexp)
 (action
  (with-stdout-to %{target}
   (bash
    "printf '(%s)' \"$(pkg-config --libs sdl2 2>/dev/null)\""))))
