(library
 (name lui_plugin_fetch)
 (modules lui_plugin_fetch)
 (libraries yojson lui_plugin)
 (foreign_stubs
  (language c)
  (names lui_plugin_fetch_stubs))
 (c_library_flags (:standard (:include c_libs.sexp))))

;; libcurl is dlopen'ed by the stub; only Linux still needs libdl for
;; that (dlopen lives in libSystem on macOS, elsewhere the stub fails).
(rule
 (target c_libs.sexp)
 (action
  (with-stdout-to %{target}
   (bash
    "case '%{system}' in linux) printf '(-ldl)';; *) printf '()';; esac"))))
