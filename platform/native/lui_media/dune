; The stubs are Objective-C on Darwin (compiled with -x objective-c
; via c_flags.sexp) and plain C elsewhere; the copy keeps dune treating
; the file as C input on every platform.

(rule
 (deps lui_media_stubs.m)
 (action (copy %{deps} lui_media_stubs.c)))

(library
 (name lui_media)
 (public_name lui.media)
 (modules lui_media)
 (libraries lui_scene lui_plugin unix yojson)
 (foreign_stubs
  (language c)
  (names lui_media_stubs)
  (flags (:standard (:include c_flags.sexp))))
 (c_library_flags (:standard (:include c_libs.sexp))))

(rule
 (target c_flags.sexp)
 (action
  (with-stdout-to
   %{target}
   (bash
    "if [ \"$(uname -s)\" = Darwin ]; then printf '(-x objective-c -fobjc-arc)'; else printf '()'; fi"))))

(rule
 (target c_libs.sexp)
 (action
  (with-stdout-to
   %{target}
   (bash
    "if [ \"$(uname -s)\" = Darwin ]; then printf '(-framework AVFoundation -framework CoreMedia -framework CoreVideo -framework AudioToolbox -framework Foundation)'; elif [ \"$(uname -s)\" = Linux ]; then printf '(-ldl)'; else printf '()'; fi"))))
