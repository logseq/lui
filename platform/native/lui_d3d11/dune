(library
 (name lui_d3d11)
 (modules lui_d3d11 hlsl_source)
 (libraries lui_scene lui_gpu)
 (foreign_stubs
  (language c)
  (names lui_d3d11_stubs))
 (c_library_flags
  (:standard
   (:include c_libs.sexp))))

(executable
 (name embed)
 (modules embed))

(rule
 (target hlsl_source.ml)
 (deps shader.hlsl)
 (action
  (with-stdout-to %{target}
   (run %{exe:embed.exe} shader.hlsl))))

(rule
 (target c_libs.sexp)
 (action
  (with-stdout-to %{target}
   (bash
    "case '%{system}' in mingw*|cygwin*) printf '(-ld3d11 -ld3dcompiler -ldxgi -lole32)';; *) printf '()';; esac"))))
