(library
 (name lui_plugin_terminal)
 (modules lui_plugin_terminal terminal_wcwidth terminal_attrs
   terminal_grid terminal_vt terminal_pty terminal_keys terminal_links
   terminal_render)
 (libraries lui_scene lui_text lui_window str)
 (foreign_stubs
  (language c)
  (names terminal_pty_stubs)
  (flags -O2 -fPIC))
 (c_library_flags (:standard (:include c_libs.sexp))))

;; libutil hosts openpty/forkpty on Linux; on macOS both live in
;; libSystem and need no extra library.
(rule
 (target c_libs.sexp)
 (action
  (with-stdout-to %{target}
   (bash
    "case '%{system}' in linux) printf '(-lutil)';; *) printf '()';; esac"))))
